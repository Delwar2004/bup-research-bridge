# Copy to backend/.env and fill in real values. Never commit .env.

# Local PostgreSQL on this host uses peer auth for Unix sockets and
# scram-sha-256 for TCP. The database owner (ubuntu) has no password, so
# postgres://user:password@localhost fails. Connect through the socket.
DATABASE_URL=postgres://ubuntu@/bup_research_bridge?host=/var/run/postgresql

PORT=3000
NODE_ENV=development

# At least 32 characters. Used to sign access tokens (HS256).
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins. Leave empty to reflect the request origin.
CORS_ORIGIN=http://localhost:5173

# Used only by scripts/create-admin.js (not by the HTTP API).
# ADMIN_FULL_NAME=Platform Admin
# ADMIN_EMAIL=admin@bup.edu.bd
# ADMIN_PASSWORD=change-this-password
