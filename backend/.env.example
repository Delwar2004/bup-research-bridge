# Copy to backend/.env and fill in real values. Never commit .env.

# postgresql://USER:PASSWORD@HOST:5432/bup_research_bridge
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bup_research_bridge

PORT=3000
NODE_ENV=development

# At least 32 characters. Used to sign access tokens (HS256).
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins. Leave empty to reflect the request origin.
CORS_ORIGIN=http://localhost:5173

# Used only by scripts/create-admin.js (not by the HTTP API).
# ADMIN_FULL_NAME=Platform Admin
# ADMIN_EMAIL=admin@bup.edu.bd
# ADMIN_PASSWORD=change-this-password
